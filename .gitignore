# ==========================================================
# Git Ignore - AI Road Damage Reporting and Maintenance System
# ==========================================================

# Environment variables and secrets
*.env
*.env.*
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
!.env.example
!client/.env.example
!server/.env.example
!ai-service/.env.example

# Sensitive keys and certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Dependencies
node_modules/
*/node_modules/
jspm_packages/
web_modules/

# Local databases and database dumps
data/
data/db/
*.db
*.sqlite
*.sqlite3
*.dump
*.sql
dump/

# User uploads and private media
uploads/
server/uploads/
client/uploads/
*.jpg
*.jpeg
*.png
*.webp
*.mp4
*.avi
*.mov
# Exceptions: keep documentation and architecture assets if any
!docs/**

# Build outputs
dist/
client/dist/
build/
out/
.parcel-cache/

# Python and virtual environments
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/
ENV/

# Large AI/ML Model Weights & Binaries
*.pt
*.pth
*.onnx
*.bin
*.h5
*.tflite
*.weights
ai-service/models/*.pt
ai-service/models/*.onnx

# Logs and runtime data
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System and IDE files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
