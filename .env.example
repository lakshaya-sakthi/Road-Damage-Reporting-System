# ==========================================================
# AI Road Damage Reporting & Maintenance Tracking System
# Root Environment Configuration Template (.env.example)
# ==========================================================

# --- SERVER CONFIGURATION (server/.env) ---
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ai_road_damage_db
JWT_SECRET=super_secret_jwt_key_road_damage_system_2026_dev_only
JWT_EXPIRES_IN=7d
AI_SERVICE_URL=http://127.0.0.1:8000
UPLOAD_DIR=uploads
CLIENT_ORIGIN=http://localhost:5173

# --- CLIENT CONFIGURATION (client/.env) ---
VITE_API_BASE_URL=http://localhost:5000/api
# Optional Google Maps JavaScript API Key (leave empty to test fallback banner)
VITE_GOOGLE_MAPS_API_KEY=

# --- AI SERVICE CONFIGURATION (ai-service/.env) ---
AI_PORT=8000
AI_HOST=0.0.0.0
MODEL_WEIGHTS_PATH=models/best.pt
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
DEVICE=cpu
